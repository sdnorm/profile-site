<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "AI agents for everyday operations | Norman Simplified" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Put AI agents to work on one recurring job, with limits you set and a person approving what goes out. Pilots are $9,500 fixed fee with Spencer Norman." %>">
    <link rel="canonical" href="https://<%= canonical_host %><%= request.path %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/fonts" %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= render "shared/posthog", site: current_site %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-site="<%= current_site %>" data-controller="notification">
    <a class="ns-skip-link" href="#main-content">Skip to content</a>
    <%= render "studio/pages/nav" %>
    <%= render "shared/flash" %>
    <div id="main-content" class="ns-content" tabindex="-1">
      <%= yield %>
    </div>
    <%= render "studio/pages/footer" %>
  </body>
</html>
