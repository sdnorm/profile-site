<section class="ns-hero ns-section" aria-labelledby="home-title">
  <div class="ns-container ns-hero__copy">
    <h1 id="home-title" class="t-display ns-hero__title">Less retyping. Less chasing paperwork.</h1>
    <p class="ns-lead">I'm Spencer Norman. I help B2B operations teams find and fix repetitive back-office work. Start with a two-week Workflow Review for <strong>$4,500</strong>: we look at three of your processes, pick the first change worth making, and you get a written recommendation with a budget. Then you decide whether to go ahead.</p>
    <div class="ns-actions">
      <%= link_to "Request a call", studio_contact_path(interest: "audit"), data: { controller: "analytics", action: "click->analytics#track", analytics_event_param: "cta_clicked", analytics_cta_param: "request_a_call", analytics_location_param: "hero", analytics_interest_param: "audit" }, class: "sn-btn sn-btn--primary sn-btn--lg" %>
    </div>
    <p class="ns-hero__note">Tell me what is taking your team's time. I reply by email within two business days.</p>
  </div>
</section>
