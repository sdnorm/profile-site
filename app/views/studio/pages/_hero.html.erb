<section class="ns-hero ns-section" aria-labelledby="home-title">
  <div class="ns-container ns-hero__copy">
    <h1 id="home-title" class="t-display ns-hero__title">Put AI agents to work. Keep control of what they can do.</h1>
    <p class="ns-lead">A customer emails asking for a quote. Before anyone opens it, an AI agent has read it, checked your price list and stock, and drafted the quote. Someone on your team looks it over and sends it. I'm Spencer Norman, and I build that for one job in your business at a time. The first is a pilot: <strong>$9,500</strong>, fixed fee, three to four weeks.</p>
    <div class="ns-actions">
      <%= link_to "Request a call", studio_contact_path(interest: "pilot"), data: { controller: "analytics", action: "click->analytics#track", analytics_event_param: "cta_clicked", analytics_cta_param: "request_a_call", analytics_location_param: "hero", analytics_interest_param: "pilot" }, class: "sn-btn sn-btn--primary sn-btn--lg" %>
    </div>
    <p class="ns-hero__note">Tell me which job is taking your team's time. I reply by email within two business days.</p>
  </div>
</section>
