<section id="services" class="ns-section ns-services" aria-labelledby="services-title">
  <div class="ns-container">
    <header class="ns-section-heading">
      <h2 id="services-title" class="t-heading">After a pilot</h2>
      <p class="ns-lead">What can follow once one job is working.</p>
    </header>

    <div class="ns-lanes">
      <article class="sn-card ns-lane" data-lane="agents" aria-labelledby="agents-title">
        <h3 id="agents-title" class="t-heading">Full build</h3>
        <p class="ns-lane__price">from <strong>$18,000</strong></p>
        <p class="ns-lane__deliverable">The job taken to production, or further jobs added.</p>
        <div class="ns-lane__actions">
          <%= link_to studio_how_we_work_path(anchor: "agents"), class: "ns-text-link" do %>
            What's included <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </article>

      <article class="sn-card ns-lane" data-lane="setup" aria-labelledby="setup-title">
        <h3 id="setup-title" class="t-heading">Your own server</h3>
        <p class="ns-lane__price">from <strong>$6,500</strong></p>
        <p class="ns-lane__deliverable">The agent moved to a server in your own hosting account.</p>
        <div class="ns-lane__actions">
          <%= link_to studio_how_we_work_path(anchor: "setup"), class: "ns-text-link" do %>
            What's included <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </article>

      <article class="sn-card ns-lane" data-lane="support" aria-labelledby="support-title">
        <h3 id="support-title" class="t-heading">Ongoing support</h3>
        <p class="ns-lane__price">from <strong>$750 a month</strong></p>
        <p class="ns-lane__deliverable">Updates, backups, monitoring and changes in business hours.</p>
        <div class="ns-lane__actions">
          <%= link_to studio_how_we_work_path(anchor: "support"), class: "ns-text-link" do %>
            What's included <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </article>
    </div>
    <p class="ns-services__note">Full build and your own server are starting prices. Your written proposal sets the fixed fee before work begins.</p>
  </div>
</section>
