<footer class="ns-footer">
  <div class="ns-container">
    <div class="ns-footer__top">
      <div>
        <p class="ns-footer__name">Norman Simplified LLC</p>
        <p class="ns-footer__tagline">Put AI agents to work. Keep control of what they can do.</p>
      </div>
      <nav aria-label="Footer">
        <ul class="ns-footer__links">
          <li><%= link_to "Agent Readiness Review", studio_agent_readiness_review_path %></li>
          <li><%= link_to "Where your agent runs", studio_where_agents_run_path %></li>
          <li><%= link_to "Examples", studio_ai_integration_path %></li>
          <li><%= link_to "How we work", studio_how_we_work_path %></li>
          <li><%= link_to "Request a call", studio_contact_path, data: { controller: "analytics", action: "click->analytics#track", analytics_event_param: "cta_clicked", analytics_cta_param: "request_a_call", analytics_location_param: "footer" } %></li>
        </ul>
      </nav>
    </div>
    <%= content_tag :p, content_for(:footer_note), class: "ns-footer__note" if content_for?(:footer_note) %>
    <div class="ns-footer__bottom">
      <p>I reply by email within two business days.</p>
      <a href="https://spencernorman.io">Spencer Norman</a>
    </div>
  </div>
</footer>
