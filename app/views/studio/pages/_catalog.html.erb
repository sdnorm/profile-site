<%
  groups = [
    {
      name: "Documents",
      intro: "Paper, PDFs, and inboxes becoming rows your system can store.",
      items: [
        {
          name: "Document intake",
          who: "Your team retypes fields from PDFs and email.",
          what: "Fields land as rows in the database you already use. Uncertain fields wait for a person to review them.",
          outcome: "How long a packet waits, and field accuracy on a labeled sample of your own files."
        },
        {
          name: "File imports and exports",
          who: "Failed imports and exports leave your team checking files by hand.",
          what: "Validation, alerts, and a path for the files that fail. Failed files are flagged for review.",
          outcome: "Time to notice a failed file, and how many bad files reach the main business system."
        },
        {
          name: "Approval routing",
          who: "Purchase orders, vendor packets, or applications wait for someone to route them.",
          what: "Routine packets route forward. Exceptions go to a named person with the source document attached.",
          outcome: "Time to clear a routine item, and how often something lands on the wrong desk."
        }
      ]
    },
    {
      name: "Answers",
      intro: "Questions answered from your material, with the source attached.",
      items: [
        {
          name: "Answers from company documents",
          who: "Staff repeatedly ask where to find policies, answers, and past decisions.",
          what: "Staff ask questions against your docs, policies, and past tickets. Each answer shows where it came from. Access follows the permissions agreed for your team.",
          outcome: "Repeat internal questions, and whether people can check the source without asking someone else."
        },
        {
          name: "AI quality checks",
          who: "An existing AI feature makes mistakes or costs too much to run.",
          what: "A set of checks from your own examples, a spending limit, and changes aimed at reducing mistakes and the cost of each completed task.",
          outcome: "Cost per task that actually finished, and failures caught by the checks before users see them."
        }
      ]
    },
    {
      name: "Workflows",
      intro: "A process that currently lives in a spreadsheet, an inbox, or an app nobody wants to touch.",
      items: [
        {
          name: "Customer onboarding",
          who: "Your team chases paperwork from every new account.",
          what: "A checklist, document requests, and a status page. The customer and your team see the same missing items.",
          outcome: "Days from signed agreement to a live account, and \"where's my paperwork\" email."
        },
        {
          name: "Spreadsheet replacement",
          who: "Conflicting spreadsheet copies make a core process hard to track.",
          what: "That workflow becomes a small internal app with a record of who changed what. The scope covers one process.",
          outcome: "Conflicting copies of the sheet, and errors you can no longer trace to a person and a time."
        },
        {
          name: "Existing app repair",
          who: "Your old application is difficult to update safely.",
          what: "Update the app, add checks, and make releases repeatable. Then improve one process, such as document intake, approvals, or reporting.",
          outcome: "Whether releases are repeatable, and the agreed measure for the process being improved."
        }
      ]
    },
    {
      name: "Numbers",
      intro: "Answers from data you already collect, in a sentence a manager can use.",
      items: [
        {
          name: "Questions about business data",
          who: "Routine business questions wait for someone to export the data.",
          what: "A question returns a chart and a short explanation linked to your business data. We test calculations and agree when an answer needs review.",
          outcome: "How often a routine question needs a manual data export."
        },
        {
          name: "Location reporting",
          who: "Managers across locations wait on a central analyst for routine reports.",
          what: "Per-location status, plus plain-language questions over operational data you already store.",
          outcome: "Time a regional manager waits for a routine number."
        }
      ]
    },
    {
      name: "Sales and support",
      intro: "Drafts and routing. A person still sends the message.",
      items: [
        {
          name: "Support request routing",
          who: "Support requests reach the wrong person or wait for a first reply.",
          what: "Incoming requests are sorted, a reply is drafted, and escalation follows rules you set. Someone on your team hits send.",
          outcome: "Time to first response, and tickets that reach the wrong queue."
        },
        {
          name: "Sales follow-up",
          who: "Deals stall while sales staff work out the next follow-up.",
          what: "Stalled deals get a drafted next step from CRM fields and call notes. The rep approves it before anything goes out.",
          outcome: "Follow-ups per rep on stalled deals, and how long deals sit in a stage."
        }
      ]
    }
  ]
%>
<section class="ns-section ns-catalog" aria-labelledby="catalog-title" data-controller="catalog">
  <div class="ns-container">
    <header class="ns-section-heading">
      <p class="sn-eyebrow">Examples</p>
      <h2 class="t-heading" id="catalog-title">Work we could do after a review</h2>
      <p class="ns-lead">Projects like these start at $18,000. Your proposal gives one fixed price, what it includes, and any running costs.</p>
    </header>
    <% groups.each_with_index do |group, index| %>
      <details class="ns-catalog__group" data-catalog-target="groups">
        <summary class="ns-catalog__summary" data-action="click->catalog#trackOpen" data-catalog-group-param="<%= group[:name] %>">
          <h3 class="t-heading" id="catalog-group-<%= index %>"><%= group[:name] %></h3>
        </summary>
        <div class="ns-catalog__body">
          <p class="ns-catalog__intro"><%= group[:intro] %></p>
          <div>
            <% group[:items].each do |item| %>
              <article class="ns-catalog__item" data-catalog-item>
                <header class="ns-catalog__item-heading">
                  <h4 class="t-heading"><%= item[:name] %></h4>
                </header>
                <dl class="ns-catalog__details">
                  <div><dt>The problem</dt><dd><%= item[:who] %></dd></div>
                  <div><dt>What we could change</dt><dd><%= item[:what] %></dd></div>
                  <div><dt>How we judge the result</dt><dd><%= item[:outcome] %></dd></div>
                </dl>
                <%= link_to "Request a call about this", studio_contact_path(interest: "build", example: item[:name]), data: { controller: "analytics", action: "click->analytics#track", analytics_event_param: "cta_clicked", analytics_cta_param: "request_a_call", analytics_location_param: "catalog", analytics_interest_param: "build" }, class: "ns-text-link" %>
              </article>
            <% end %>
          </div>
        </div>
      </details>
    <% end %>
  </div>
</section>
