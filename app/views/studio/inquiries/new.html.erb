<% content_for :title, "Request a call | Norman Simplified" %>
<% content_for :description, "Tell Spencer where paperwork or repeated data entry slows your team down. He replies by email within two business days to discuss a 25-minute call." %>
<% content_for :head do %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<% end %>

<main class="ns-container ns-section ns-contact">
  <header class="ns-section-heading ns-contact__hero">
    <p class="sn-eyebrow">Contact</p>
    <h1 class="t-display">Request a call</h1>
    <p class="ns-lead">Tell me where paperwork or repeated data entry slows your team down. I reply by email within two business days. If it looks like a fit, we set up a 25-minute call.</p>
    <p>You don't need to know the solution yet.</p>
  </header>

  <div class="ns-editorial-grid ns-contact__grid">
    <div id="inquiry_panel" class="ns-contact__panel">
      <% if @sent %>
        <%= render "studio/inquiries/success", interest: "unknown" %>
      <% else %>
        <%= render "studio/inquiries/form", inquiry: @inquiry %>
      <% end %>
    </div>
    <aside class="ns-contact__next" aria-labelledby="contact-next-heading">
      <h2 id="contact-next-heading" class="t-heading">What we can discuss</h2>
      <p>The work taking your team's time, the tools you use today, and whether a Workflow Review would help.</p>
      <p>A Workflow Review is $4,500 fixed fee, over two weeks. You get one recommended first change in writing, with a budget range.</p>
    </aside>
  </div>
</main>
