<% content_for :title, "Request a call | Norman Simplified" %>
<% content_for :description, "Tell Spencer the workflow that is stuck. He replies by email within two business days. This form does not reserve a time." %>

<main class="ns-container ns-section ns-contact">
  <header class="ns-section-heading ns-contact__hero">
    <p class="sn-eyebrow">Contact</p>
    <h1 class="t-display">Request a call</h1>
    <p class="ns-lead">Describe the work that is still done by hand. I read it and reply by email within two business days. If a call makes sense, you and I set a time by email. This page does not book a slot.</p>
  </header>

  <div class="ns-editorial-grid ns-contact__grid">
    <aside class="ns-contact__next" aria-labelledby="contact-next-heading">
      <h2 id="contact-next-heading" class="t-heading">After you send it</h2>
      <ul>
        <li>You see a confirmation on this page</li>
        <li>I reply by email within two business days</li>
        <li>If it is a fit and I have room, you and I pick a time in that email thread</li>
        <li>If it is not a fit, I say so</li>
      </ul>
      <div class="ns-contact__note ns-prose">
        <p>The first call is 25 minutes.</p>
        <p>I do not take on work involving protected health information (PHI).</p>
      </div>
    </aside>

    <div id="inquiry_panel" class="ns-contact__panel">
      <% if @sent %>
        <%= render "studio/inquiries/success" %>
      <% else %>
        <%= render "studio/inquiries/form", inquiry: @inquiry %>
      <% end %>
    </div>
  </div>
</main>
